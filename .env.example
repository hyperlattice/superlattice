# Required: Discord Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Required: application ID (General Information)
DISCORD_CLIENT_ID=
# Optional: server ID for fast guild command registration and server restriction.
# Leave blank for global server-only commands.
DISCORD_GUILD_ID=
# Required: destination server text channel ID (View Channel, Send Messages, Embed Links)
DISCORD_CHANNEL_ID=
# Organization login; defaults to hyperlattice
GITHUB_ORGANIZATION=hyperlattice
# Required: generate with openssl rand -hex 32 (at least 32 characters)
GITHUB_WEBHOOK_SECRET=
# Optional local defaults; Compose sets these to 3000 and /app/data.
PORT=3000
DATA_DIR=./data
